[flake8]
# Configuration for flake8 Python linter
max-line-length = 120
extend-ignore = E203, W503, E501
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    backend/venv,
    backend/alembic/versions,
    node_modules,
    .next,
    build,
    dist

per-file-ignores =
    __init__.py:F401
    backend/app/main.py:E402

max-complexity = 15
