# SkillForge Frontend Dockerfile - OPTIMIZED
# Development-optimized image for local Docker deployment

FROM node:18-alpine

WORKDIR /app

# Install dependencies with npm ci (more reliable than npm install)
# Copy ONLY package files first (changes rarely, cache-friendly)
COPY package*.json ./
RUN npm ci --prefer-offline --no-audit 2>/dev/null || npm install

# Copy application code (changes frequently, doesn't break cache)
COPY . .

# Build environment variables
# Note: Inside Docker container, 'backend' is the service name in the network
ENV NEXT_PUBLIC_API_BASE="http://backend:8001" \
    NEXT_PUBLIC_STRIPE_KEY="pk_test_51SkcWEBydMsdVDYvDjEH5cNq0BO8VbYGcTq64NdlpvxFwaGaaaUIrKDFrTAAV4TrNYAAz3JdOvRFcDz8PWQLBc3K00kQDXwyCd" \
    NODE_ENV="development" \
    PORT=3000

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1

# Start Next.js in development mode for hot reload
CMD ["npm", "run", "dev"]
