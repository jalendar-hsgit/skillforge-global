# SkillForge Backend Dockerfile - OPTIMIZED
# Multi-stage build for optimized production image

FROM python:3.11-slim as builder

WORKDIR /app

# Install build dependencies (cached separately)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy ONLY requirements (changes rarely, cache-friendly)
COPY backend/requirements.txt .

# Install dependencies with caching (this layer is reused)
RUN pip install --user --no-cache-dir -r requirements.txt

# Production stage
FROM python:3.11-slim

WORKDIR /app

# Create non-root user for security
RUN useradd -m -u 1000 skillforge

# Install runtime dependencies (including PostgreSQL client library for psycopg2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy Python dependencies from builder
COPY --from=builder /root/.local /home/skillforge/.local

# Copy application code
COPY backend/app /app/app
COPY backend/init_db.py /app/
COPY backend/.env.production /app/.env

# Set environment variables
ENV PATH=/home/skillforge/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8001

# Change ownership to non-root user
RUN chown -R skillforge:skillforge /app
USER skillforge

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/api/v1/health || exit 1

# Command to run
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]

EXPOSE 8001
